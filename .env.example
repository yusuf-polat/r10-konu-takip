# ==============================================================================
# R10.net MCP Server Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this file as `.env`: cp .env.example .env
# 2. Open https://www.r10.net in your web browser and log in.
# 3. Open Developer Tools (F12) -> Network tab.
# 4. Click any tab (e.g. "Son Açılan") or refresh the page.
# 5. Look for a request to `ajax.php?do=anasayfaTab`.
# 6. Copy the entire 'Cookie' header value and paste it into R10_COOKIE below.
# 7. (Optional) Copy the 'securitytoken' from the request payload into R10_SECURITY_TOKEN.
#    Note: If omitted or expired, the server will attempt to auto-fetch a fresh token.
# ==============================================================================

R10_COOKIE="RID=your_rid_cookie; r10userid=12345; cf_clearance=your_cf_clearance; vbseo_loggedin=yes"
R10_SECURITY_TOKEN="1780000000-abcdef0123456789abcdef0123456789abcdef01"
R10_USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36"
